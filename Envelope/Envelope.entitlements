<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud sync: SwiftData mirrors the store to the user's private CloudKit database. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(SPAAR_CLOUDKIT_CONTAINER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Silent pushes tell the app another device changed something. Xcode switches this
	     to production when exporting for the App Store / TestFlight. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
